# Nothing here belongs in the image: the build only needs pyproject.toml,
# uv.lock and app.py. .venv in particular must not be copied over the one
# uv creates inside the image.
.git
.github
.venv
__pycache__/
# Left behind by a local `uv lock`: with a dynamic version uv builds the
# project metadata to resolve it. Gitignored already, but a local build
# copies the working tree, not the commit.
*.egg-info/
*.py[cod]
config.ini
README.md
